# studio/.env.example — copy to .env.local and fill in. .env.local is gitignored.
#
# WHICH OF THESE YOU NEED DEPENDS ON THE ARCHETYPE, and the Keys tab in the console
# works it out for you. The composited and narrated-stills paths need two. Nothing
# in this repo needs a YouTube key: publishing to a channel is a human action.

# The agent itself — script, shot list, judging the contact sheet.
ANTHROPIC_API_KEY=

# Images — model sheets, plates, sprites, keyframes. Already used by gen-assets.py.
GEMKEY=

# Narration, ONLY for a film with no product library behind it. A Bizzing story film
# is cut to the app's own voice and may not be cut to anything else.
# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=

# Motion — only for the keyframe, generative and hybrid archetypes. Veo uses GEMKEY.
# KLING_ACCESS_KEY=
# KLING_SECRET_KEY=
# RUNWAYML_API_SECRET=

# Where masters go, because they never go in git.
# GDRIVE_FOLDER_ID=
